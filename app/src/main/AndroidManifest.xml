<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    xmlns:tools="http://annotation.com"
    package="com.android.system.framework.print">

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Print Framework Extension"
        android:supportsRtl="true"
        android:theme="@style/Theme.JustPlayHelper"
        tools:targetApi="34">
        
        <activity
            android:name="com.example.justplayhelper.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JustPlayHelper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.example.justplayhelper.AdDetectionService"
            android:exported="false"
            android:label="Android Print Spooler Extension"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.view.accessibility.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
